{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "STM32: Build",
            "type": "shell",
            "command": "make",
            "args": ["-j8"],
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "STM32: Clean",
            "type": "shell",
            "command": "make",
            "args": ["clean"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "STM32: Fetch ST dependencies",
            "type": "shell",
            "command": "make",
            "args": ["deps"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "STM32: Flash with OpenOCD",
            "type": "shell",
            "command": "make",
            "args": ["flash"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$gcc"]
        }
    ]
}
